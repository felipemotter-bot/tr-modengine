<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_order_form_inherit_delivery_planning" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.delivery.planning</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='effective_date']" position="after">
                <field name="next_planned_delivery_date" readonly="1" />
            </xpath>
        </field>
    </record>

</odoo>
