#. module: tr_sales_rep_access
#: model:ir.model.fields,help:tr_sales_rep_access.field_res_config_settings__tr_sales_rep_default_category_ids
msgid ""
"Categories assigned to the Allowed Product Categories of every new agent "
"partner (agent=True) created without an explicit value. Does not "
"retroactively update existing agents."
msgstr ""
"Categorias atribuídas à Categorias de Produto Permitidas de todo novo "
"parceiro agente (agent=True) criado sem um valor explícito. Não atualiza "
"retroativamente agentes existentes."

#. module: tr_sales_rep_access
#: model_terms:ir.ui.view,arch_db:tr_sales_rep_access.res_config_settings_view_form
msgid ""
"Categories automatically assigned to the\n"
"                                Allowed Product Categories of every new\n"
"                                agent partner. Does not retroactively update\n"
"                                existing agents."
msgstr ""
"Categorias atribuídas automaticamente à\n"
"                                Categorias de Produto Permitidas de todo\n"
"                                novo parceiro agente. Não atualiza\n"
"                                retroativamente agentes existentes."

#. module: tr_sales_rep_access
#: model:ir.model.fields,help:tr_sales_rep_access.field_res_partner__excluded_category_ids
#: model:ir.model.fields,help:tr_sales_rep_access.field_res_users__excluded_category_ids
msgid ""
"Categories explicitly excluded from the allowed scope, including their "
"descendants. Use to carve out a subtree while keeping its parent in allowed."
msgstr ""
"Categorias explicitamente excluídas do escopo permitido, incluindo suas "
"subcategorias. Use para recortar uma subárvore mantendo o pai em permitidas."

#. module: tr_sales_rep_access
#: model:ir.model.fields,help:tr_sales_rep_access.field_account_bank_statement_line__sales_rep_partner_id
#: model:ir.model.fields,help:tr_sales_rep_access.field_account_move__sales_rep_partner_id
#: model:ir.model.fields,help:tr_sales_rep_access.field_account_payment__sales_rep_partner_id
msgid ""
"Commercial agent responsible for this invoice, propagated from the "
"originating sale order snapshot."
msgstr ""
"Agente comercial responsável por esta fatura, propagado do registro do "
"pedido de venda de origem."

#. module: tr_sales_rep_access
#: model:ir.model.fields,help:tr_sales_rep_access.field_sale_order__sales_rep_partner_id
msgid ""
"Commercial agent responsible for this order, captured at creation from the "
"customer's agent_ids. Re-synced if the customer changes while the order is "
"in draft. Immutable after draft."
msgstr ""
"Agente comercial responsável por este pedido, capturado na criação a partir "
"de agent_ids do cliente. Ressincronizado se o cliente mudar enquanto o "
"pedido está em rascunho. Imutável depois de sair do rascunho."

