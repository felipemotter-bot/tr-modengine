<odoo>

    <record id="view_pricelist_basic_wizard_form_simulate_rep" model="ir.ui.view">
        <field name="name">tr.pricelist.basic.wizard.form.simulate.rep</field>
        <field name="model">tr.pricelist.basic.wizard</field>
        <field
      name="inherit_id"
      ref="tr_pricelist_report.view_pricelist_basic_wizard_form"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field
          name="simulate_as_agent_id"
          groups="sales_team.group_sale_manager"
          options="{'no_create': True}"
        />
            </xpath>
        </field>
    </record>

</odoo>
