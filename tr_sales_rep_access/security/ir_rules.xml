<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        res.partner needs special handling: res_partner_rule_private_employee
        is a rule on base.group_user (base_security.xml:78) that broadens
        visibility to almost everything. Since our rep group implies
        base.group_user, a simple per-group rule would be combined by OR
        with that permissive rule and the scope narrowing would be lost.
        The pattern below:
          1. per-group OPEN rule that broadens the OR (covers cases where
             base.group_user rules are restrictive),
          2. GLOBAL rule with conditional `user.has_group(...)` that
             applies AND to restrict scope when the user is a rep.
        For sale/account models, the core "personal" rules belong to
        sales_team.group_sale_salesman (not base.group_user) so a simple
        per-group rule is sufficient. Write-after-draft enforcement for
        sale.order / sale.order.line happens in Python overrides because
        sale_stock performs legitimate internal writes on confirmed
        orders (procurement_group_id, etc.) that a state-based rule
        would incorrectly block.
    -->

    <!-- ============================================================ -->
    <!-- res.partner — open broadener + global conditional scope     -->
    <!-- ============================================================ -->

    <record id="rule_res_partner_rep_open" model="ir.rule">
        <field name="name">res.partner: sales rep open (group OR broadener)</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_res_partner_rep_scope" model="ir.rule">
        <field name="name">res.partner: sales rep scope (global AND)</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <!--
            4th OR clause: partners of historical sales/invoices where
            the rep is the snapshot. Sale/move rules are based on an
            immutable ``sales_rep_partner_id`` snapshot, while the live
            ``agent_ids`` clause above follows the current carteira.
            After an agent rotation the two diverge: the rep still owns
            the old orders/invoices (snapshot match) but would lose
            read access to their partners (agent_ids no longer match),
            breaking form/list views and report printing. Granting the
            rep access to the commercial entity of any historical record
            they snapshot aligns with the documented behaviour in
            USAGE_GUIDE.md section 8 ("A1 continua enxergando esses
            pedidos e suas faturas"). The sudo().search() runs once
            per request (ir.rule domain cache) so performance cost is
            bounded by the rep's snapshot volume.
        -->
        <field name="domain_force">[
            '|', '|', '|',
            ('id', '=', user.partner_id.id),
            ('id', 'in', user.env['res.users'].with_context(active_test=False).sudo().search([('partner_id', '!=', False), ('partner_id.agent', '=', False)]).mapped('partner_id').ids),
            ('commercial_partner_id.agent_ids', 'in', [user.partner_id.id]),
            ('commercial_partner_id', 'in',
                user.env['sale.order'].sudo().search([('sales_rep_partner_id', '=', user.partner_id.id)]).mapped('partner_id').mapped('commercial_partner_id').ids
                + user.env['account.move'].sudo().search([('sales_rep_partner_id', '=', user.partner_id.id)]).mapped('partner_id').mapped('commercial_partner_id').ids)
        ] if user.has_group('tr_sales_rep_access.group_sales_rep_external') else [(1, '=', 1)]</field>
    </record>

    <!-- ============================================================ -->
    <!-- sale.order — simple per-group rule by snapshot              -->
    <!-- ============================================================ -->

    <record id="rule_sale_order_rep" model="ir.rule">
        <field name="name">sale.order: sales rep scope</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
        <field
      name="domain_force"
    >[('sales_rep_partner_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- ============================================================ -->
    <!-- sale.order.line — simple per-group rule by order snapshot   -->
    <!-- ============================================================ -->

    <record id="rule_sale_order_line_rep" model="ir.rule">
        <field name="name">sale.order.line: sales rep scope</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field
      name="domain_force"
    >[('order_id.sales_rep_partner_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- ============================================================ -->
    <!-- account.move — read-only per-group rule by snapshot         -->
    <!-- ============================================================ -->

    <record id="rule_account_move_rep" model="ir.rule">
        <field name="name">account.move: sales rep scope</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field
      name="domain_force"
    >[('sales_rep_partner_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- ============================================================ -->
    <!-- account.move.line — read-only per-group rule by move        -->
    <!-- ============================================================ -->

    <record id="rule_account_move_line_rep" model="ir.rule">
        <field name="name">account.move.line: sales rep scope</field>
        <field name="model_id" ref="account.model_account_move_line" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field
      name="domain_force"
    >[('move_id.sales_rep_partner_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- ============================================================ -->
    <!-- tr.partner.change.request — per-group rule by snapshot      -->
    <!-- ============================================================ -->

    <record id="rule_partner_change_request_rep" model="ir.rule">
        <field name="name">tr.partner.change.request: sales rep scope</field>
        <field name="model_id" ref="model_tr_partner_change_request" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
        <field
      name="domain_force"
    >[('sales_rep_partner_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- ============================================================ -->
    <!-- tr.sales.profile + children — rep sees only its own profile -->
    <!--                                                              -->
    <!-- partner.sales_profile_id is company_dependent, so a rep may  -->
    <!-- hold a different profile per company. The domain iterates    -->
    <!-- over the active company_ids (allowed_company_ids) so every   -->
    <!-- profile the rep owns across currently enabled companies is   -->
    <!-- included. False entries are harmless: Many2one filters drop  -->
    <!-- them.                                                        -->
    <!-- ============================================================ -->

    <record id="rule_sales_profile_rep_self_only" model="ir.rule">
        <field name="name">tr.sales.profile: sales rep sees only own profile</field>
        <field name="model_id" ref="tr_commercial_policy.model_tr_sales_profile" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[('id', 'in', [
            user.partner_id.with_company(company).sales_profile_id.id
            for company in user.env['res.company'].browse(company_ids)
        ])]</field>
    </record>

    <record id="rule_sales_profile_rule_rep_self_only" model="ir.rule">
        <field
      name="name"
    >tr.sales.profile.rule: sales rep sees only rules of own profile</field>
        <field name="model_id" ref="tr_commercial_policy.model_tr_sales_profile_rule" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[('profile_id', 'in', [
            user.partner_id.with_company(company).sales_profile_id.id
            for company in user.env['res.company'].browse(company_ids)
        ])]</field>
    </record>

    <record id="rule_sales_profile_commission_band_rep_self_only" model="ir.rule">
        <field
      name="name"
    >tr.sales.profile.commission.band: sales rep sees only commission bands of own profile</field>
        <field
      name="model_id"
      ref="tr_commercial_policy.model_tr_sales_profile_commission_band"
    />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[('rule_id.profile_id', 'in', [
            user.partner_id.with_company(company).sales_profile_id.id
            for company in user.env['res.company'].browse(company_ids)
        ])]</field>
    </record>

    <record id="rule_sales_profile_order_band_rep_self_only" model="ir.rule">
        <field
      name="name"
    >tr.sales.profile.order.band: sales rep sees only order bands of own profile</field>
        <field
      name="model_id"
      ref="tr_commercial_policy.model_tr_sales_profile_order_band"
    />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[('rule_id.profile_id', 'in', [
            user.partner_id.with_company(company).sales_profile_id.id
            for company in user.env['res.company'].browse(company_ids)
        ])]</field>
    </record>

    <!-- ============================================================ -->
    <!-- product.pricelist — rep sees only pricelists in the rep's    -->
    <!-- ``allowed_pricelist_ids`` whitelist. Empty whitelist means no -->
    <!-- restriction (pass-through) so the feature is opt-in per rep. -->
    <!-- Global rule with conditional: acts only when the acting user -->
    <!-- is a rep AND the list is non-empty, otherwise returns True   -->
    <!-- for everyone (admins, managers, reps without a whitelist).   -->
    <!-- ============================================================ -->

    <record id="rule_product_pricelist_rep_scope" model="ir.rule">
        <field name="name">product.pricelist: sales rep scope</field>
        <field name="model_id" ref="product.model_product_pricelist" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field
      name="domain_force"
    >[('id', 'in', user.partner_id.sudo().allowed_pricelist_ids.ids)] if user.has_group('tr_sales_rep_access.group_sales_rep_external') and user.partner_id.sudo().allowed_pricelist_ids else [(1, '=', 1)]</field>
    </record>

</odoo>
