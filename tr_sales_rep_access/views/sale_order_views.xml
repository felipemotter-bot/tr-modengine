<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_sale_order_form_sales_rep_access" model="ir.ui.view">
        <field name="name">sale.order.form.sales.rep.access</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="sales_rep_partner_id" readonly="1" />
            </xpath>
            <!--
                Insert the rep notes group right after ``sale_info`` so
                the adjacency stays explicit: the core's Other Info
                page has two sibling groups (``sales_person`` and
                ``sale_info``) and a ``//page/group`` selector would
                be ambiguous between them.
            -->
            <xpath expr="//group[@name='sale_info']" position="after">
                <group name="sales_rep" string="Sales Rep">
                    <field
            name="tr_rep_notes"
            nolabel="1"
            placeholder="Internal notes for the sales manager..."
          />
                </group>
            </xpath>
        </field>
    </record>

    <!-- PR 8 — hide chatter for reps (defense in depth; field-level
         groups= on message_ids / message_follower_ids is the real
         server-side barrier). -->
    <record id="view_sale_order_form_hide_chatter_rep" model="ir.ui.view">
        <field name="name">sale.order.form.hide.chatter.rep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_chatter')]" position="attributes">
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>
</odoo>
