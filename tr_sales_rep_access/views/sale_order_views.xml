<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_sale_order_form_sales_rep_access" model="ir.ui.view">
        <field name="name">sale.order.form.sales.rep.access</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="sales_rep_partner_id" readonly="1" />
            </xpath>
            <!--
                Insert the rep notes group right after ``sale_info`` so
                the adjacency stays explicit: the core's Other Info
                page has two sibling groups (``sales_person`` and
                ``sale_info``) and a ``//page/group`` selector would
                be ambiguous between them.
            -->
            <xpath expr="//group[@name='sale_info']" position="after">
                <group name="sales_rep" string="Sales Rep">
                    <field
            name="tr_rep_notes"
            nolabel="1"
            placeholder="Internal notes for the sales manager..."
          />
                </group>
            </xpath>
        </field>
    </record>

    <!-- PR 14 — hide Optional Products and Other Information tabs for reps. -->
    <record id="view_sale_order_form_rep_tabs" model="ir.ui.view">
        <field name="name">sale.order.form.rep.tabs</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>

    <!--
        Hide the "Invoices" smart button from reps. Reps have a
        record-scoped read on account.move but the button exposes
        invoice UI the rep doesn't need. Field-level groups= on
        invoice_count + invoice_ids would also kill the smart
        button count widget but requires adding the fields to our
        model override — not worth it for this cosmetic button hide.
    -->
    <record id="view_sale_order_form_rep_hide_invoice_button" model="ir.ui.view">
        <field name="name">sale.order.form.rep.hide.invoice.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>

    <!--
        Hide commission UI buttons from reps. The fields themselves
        (commission_total, commission_status, agent_ids, partner_agent_ids)
        are blocked at model level via groups=_GROUPS_NO_REP. Only the
        interactive buttons still need XML-level hide.
    -->
    <record id="view_sale_order_form_hide_commission_rep" model="ir.ui.view">
        <field name="name">sale.order.form.hide.commission.rep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_commission.view_order_agent_form_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_edit_agents']" position="attributes">
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
            <xpath
        expr="//group[@name='group_recompute_commission']"
        position="attributes"
      >
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>

    <!--
        The unmanaged_commission_warning banner from tr_commercial_policy
        wraps its field in a <div class="alert alert-warning"> whose
        visibility depends on the field value. With the field hidden at
        model level for reps, the attrs cannot evaluate and the empty
        banner stays visible. Add groups= to the div so it is removed
        from the rep's arch entirely.
    -->
    <record id="view_sale_order_form_hide_unmanaged_warning_rep" model="ir.ui.view">
        <field name="name">sale.order.form.hide.unmanaged.warning.rep</field>
        <field name="model">sale.order</field>
        <field
      name="inherit_id"
      ref="tr_commercial_policy.sale_order_form_commercial_policy"
    />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='unmanaged_commission_warning']/.."
        position="attributes"
      >
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>

    <!--
        The inline order_line popup has a notebook with technical tabs
        (fiscal_taxes, amounts, others, fiscal_line_extra_info,
        accounting, commissions) that expose data the rep does not need
        to see. Hiding the whole notebook is cleaner than per-tab
        groups= and avoids future regressions when new tabs are added.
    -->
    <record id="view_sale_order_form_hide_line_notebook_rep" model="ir.ui.view">
        <field name="name">sale.order.form.hide.line.notebook.rep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="l10n_br_sale.l10n_br_sale_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//notebook" position="attributes">
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>

    <!-- PR 8 — hide chatter for reps (defense in depth; field-level
         groups= on message_ids / message_follower_ids is the real
         server-side barrier). -->
    <record id="view_sale_order_form_hide_chatter_rep" model="ir.ui.view">
        <field name="name">sale.order.form.hide.chatter.rep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_chatter')]" position="attributes">
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>
</odoo>
