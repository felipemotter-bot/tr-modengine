<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Grant the external rep access to the Sales app menus.
        We add the rep group without removing existing access (command 4).
        sale_menu_root has a custom group restriction from another module, so
        we include it here to make the app icon visible on the home screen.
        sale_order_menu has no groups — no override needed.
    -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_sales_rep_external'))]" />
    </record>

    <record id="sale.menu_sale_quotations" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_sales_rep_external'))]" />
    </record>

    <record id="sale.menu_sale_order" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_sales_rep_external'))]" />
    </record>

    <!--
        Grant access to the Contacts app. The ``contacts`` submenu
        was restricted by a project-specific custom group
        (``VISUALIZAR CONTATOS``, created at runtime without XML ID)
        so base.group_user alone isn't enough. Adding the rep group
        to the submenu's groups_id makes the app appear on the home
        screen and opens the Contacts list.
    -->
    <record id="contacts.res_partner_menu_contacts" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_sales_rep_external'))]" />
    </record>

    <!--
        Hide top-level menus reps should not access. ir.rule is used
        instead of modifying each menu's groups_id: the ``!group``
        syntax only works on view attributes (fields/buttons), not on
        the menuitem tag, and selectively removing ``base.group_user``
        from calendar/dashboard menus would hide them from everyone.
    -->
    <record id="rule_hide_menus_for_rep" model="ir.rule">
        <field name="name">ir.ui.menu: hide HR/Calendar/Dashboards from reps</field>
        <field name="model_id" ref="base.model_ir_ui_menu" />
        <field name="groups" eval="[(4, ref('group_sales_rep_external'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field
      name="domain_force"
    >[('id', 'not in', [user.env.ref('hr.menu_hr_root').id, user.env.ref('spreadsheet_dashboard.spreadsheet_dashboard_menu_root').id, user.env.ref('calendar.mail_menu_calendar').id])]</field>
    </record>
</odoo>
