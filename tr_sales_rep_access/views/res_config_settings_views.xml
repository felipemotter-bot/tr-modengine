<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
      name="name"
    >res.config.settings.view.form.inherit.tr.sales.rep.access</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pricing_setting_container']" position="before">
                <h2>Sales Rep Access</h2>
                <div
          class="row mt16 o_settings_container"
          id="tr_sales_rep_access_settings"
        >
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="tr_sales_rep_default_category_ids" />
                            <div class="text-muted">
                                Categories automatically assigned to the
                                Allowed Product Categories of every new
                                agent partner. Does not retroactively update
                                existing agents.
                            </div>
                            <div class="content-group mt16">
                                <field
                  name="tr_sales_rep_default_category_ids"
                  widget="many2many_tags"
                  options="{'no_create': True}"
                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
