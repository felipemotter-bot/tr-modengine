<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        PR 7 commit 3 — hide the "Print Price List" button on the
        partner form for the rep, as defense in depth for the
        server-side guard on ``action_print_pricelist`` /
        ``action_print_pricelist_from_menu`` (see
        ``models/tr_pricelist_report.py``).

        Relying on view hiding alone would leave the action-menu
        server binding open (``binding_model_id = res.partner`` in
        upstream), which surfaces the action in every partner list
        and form. The Python override is what guarantees the rep
        cannot actually trigger the wizard; this xpath just keeps
        the UI clean.
    -->
    <record id="res_partner_form_sales_rep_hide_pricelist_button" model="ir.ui.view">
        <field name="name">res.partner.form.sales.rep.hide.pricelist.button</field>
        <field name="model">res.partner</field>
        <field
      name="inherit_id"
      ref="tr_pricelist_report.view_partner_form_pricelist_report"
    />
        <field name="arch" type="xml">
            <xpath
        expr="//button[@name='action_print_pricelist']"
        position="attributes"
      >
                <attribute
          name="groups"
        >!tr_sales_rep_access.group_sales_rep_external</attribute>
            </xpath>
        </field>
    </record>
</odoo>
