<odoo>

    <record id="action_report_pricelist_xlsx" model="ir.actions.report">
        <field name="name">Price List (XLSX)</field>
        <field name="model">tr.pricelist.report.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">tr_pricelist_report.report_pricelist_xlsx</field>
        <field name="report_file">tr_pricelist_report.report_pricelist_xlsx</field>
        <field
      name="print_report_name"
    >'Price List - %s - %s' % (object.condition_id.partner_id.name or '', time.strftime('%Y-%m-%d'))</field>
    </record>

</odoo>
