<odoo>

    <template id="report_pricelist_document">
        <t t-call="web.html_container">
            <t t-call="trento_report_utils.external_layout_boxed_compact">
                <div class="page">

                    <t t-call="tr_pricelist_report.report_pricelist_styles" />

                    <!-- Header: title + client + emission -->
                    <div class="pricelist-header">
                        <h2 class="pricelist-header-title">TABELA DE PREÇOS</h2>
                        <div class="pricelist-header-meta">
                            <div>
                                <strong>Cliente:</strong>
                                <span
                  t-esc="partner.legal_name or partner.display_name"
                />
                            </div>
                            <div>
                                <strong>Emissão:</strong>
                                <span
                  t-esc="date_issued"
                  t-options="{'widget': 'date'}"
                />
                            </div>
                        </div>
                    </div>

                    <!-- Main sections (categoria/marca depending on layout) -->
                    <t t-foreach="sections" t-as="section">
                        <div class="pricelist-section">
                            <h3 class="pricelist-section-title">
                                <t t-esc="section['title']" />
                            </h3>
                            <table class="pricelist-table">
                                <thead>
                                    <tr>
                                        <th
                      class="pricelist-cell-description"
                    >Descrição</th>
                                        <th
                      t-if="layout == 'historico'"
                      style="width: 12%;"
                    >Qtd.</th>
                                        <t t-if="discount_display == 'show_discounts'">
                                            <th style="width: 14%;">Preço Ref.</th>
                                            <th style="width: 9%;">Desc. %</th>
                                        </t>
                                        <th style="width: 14%;">Preço</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="section['rows']" t-as="row">
                                        <tr>
                                            <td class="pricelist-cell-description">
                                                <t
                          t-if="layout == 'historico'"
                          t-esc="row['product'].display_name"
                        />
                                                <t
                          t-if="layout != 'historico'"
                          t-esc="row['template'].display_name"
                        />
                                            </td>
                                            <td t-if="layout == 'historico'">
                                                <span
                          t-esc="row['qty']"
                          t-options="{'widget': 'float', 'precision': 2}"
                        /> <t t-esc="row['uom_label']" />
                                            </td>
                                            <t
                        t-if="discount_display == 'show_discounts'"
                      >
                                                <td>
                                                    <span
                            t-if="row['pricing']['seller_discount'] >= 0"
                            t-esc="row['pricing']['reference']"
                            t-options="{'widget': 'monetary', 'display_currency': condition.pricelist_id.currency_id}"
                          />
                                                    <span
                            t-else=""
                            t-esc="row['pricing']['price_unit']"
                            t-options="{'widget': 'monetary', 'display_currency': condition.pricelist_id.currency_id}"
                          />
                                                </td>
                                                <td>
                                                    <span
                            t-if="row['pricing']['seller_discount'] >= 0"
                            t-esc="row['pricing']['seller_discount']"
                            t-options="{'widget': 'float', 'precision': 2}"
                          />
                                                    <span t-else="">0,00</span>
                                                </td>
                                            </t>
                                            <td class="pricelist-cell-price">
                                                <span
                          t-esc="row['pricing']['price_unit']"
                          t-options="{'widget': 'monetary', 'display_currency': condition.pricelist_id.currency_id}"
                        />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>

                    <!-- Variant-level exceptions -->
                    <t t-if="variant_exceptions">
                        <div class="pricelist-section">
                            <h3
                class="pricelist-section-title"
              >Preços Especiais por Variante</h3>
                            <table class="pricelist-table">
                                <thead>
                                    <tr>
                                        <th
                      class="pricelist-cell-description"
                    >Descrição</th>
                                        <th style="width: 14%;">Preço</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="variant_exceptions" t-as="exc">
                                        <td
                      class="pricelist-cell-description"
                      t-esc="exc['product'].display_name"
                    />
                                        <td class="pricelist-cell-price">
                                            <span
                        t-esc="exc['price_unit']"
                        t-options="{'widget': 'monetary', 'display_currency': condition.pricelist_id.currency_id}"
                      />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>

                    <!-- Quantity-tier exceptions -->
                    <t t-if="qty_exceptions">
                        <div class="pricelist-section">
                            <h3
                class="pricelist-section-title"
              >Preços por Quantidade</h3>
                            <table class="pricelist-table">
                                <thead>
                                    <tr>
                                        <th
                      class="pricelist-cell-description"
                    >Descrição</th>
                                        <th style="width: 14%;">Qtd. Mín.</th>
                                        <th style="width: 14%;">Preço</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="qty_exceptions" t-as="qex">
                                        <td
                      class="pricelist-cell-description"
                      t-esc="qex['target'].display_name"
                    />
                                        <td>
                                            <span
                        t-esc="qex['min_qty']"
                        t-options="{'widget': 'float', 'precision': 2}"
                      />
                                        </td>
                                        <td class="pricelist-cell-price">
                                            <span
                        t-esc="qex['pricing']['price_unit']"
                        t-options="{'widget': 'monetary', 'display_currency': condition.pricelist_id.currency_id}"
                      />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>

                    <!-- Commercial conditions block -->
                    <div class="pricelist-section">
                        <h3 class="pricelist-section-title">Condições Comerciais</h3>
                        <ul style="margin: 6pt 0 0 16pt; font-size: 10pt; color: #333;">
                            <li t-if="condition.payment_term_id">
                                <strong>Prazo de pagamento:</strong>
                                <span t-esc="condition.payment_term_id.name" />
                            </li>
                            <li t-if="condition.payment_mode_id">
                                <strong>Modo de pagamento:</strong>
                                <span t-esc="condition.payment_mode_id.name" />
                            </li>
                            <li t-if="condition.incoterm_id">
                                <strong>Incoterm:</strong>
                                <span t-esc="condition.incoterm_id.display_name" />
                            </li>
                            <li t-if="condition.cash_discount">
                                Para pagamento à vista, abater
                                <span
                  t-esc="condition.cash_discount"
                  t-options="{'widget': 'float', 'precision': 2}"
                />% do total.
                            </li>
                            <li t-if="condition.fob_discount">
                                Para retirada FOB, abater
                                <span
                  t-esc="condition.fob_discount"
                  t-options="{'widget': 'float', 'precision': 2}"
                />% do total.
                            </li>
                        </ul>
                        <!--
                            History-layout note anchored inline at the end
                            of "Condições Comerciais". Pinning it here (vs.
                            a floating footer) also avoids pagination
                            pitfalls with ``web.external_layout``.
                        -->
                        <p t-if="layout == 'historico'" class="pricelist-history-note">
                            Qtd. considera pedidos de venda confirmados nos
                            últimos <t t-esc="history_months_back" /> meses
                            (desde <span
                t-esc="date_history_threshold"
                t-options="{'widget': 'date'}"
              />). Devoluções não são descontadas.
                        </p>
                    </div>

                </div>
            </t>
        </t>
    </template>

</odoo>
