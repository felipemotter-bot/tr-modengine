<odoo noupdate="1">

    <record id="config_category_depth" model="ir.config_parameter">
        <field name="key">tr_pricelist_report.category_depth</field>
        <field name="value">-2</field>
    </record>

    <record id="config_group_attribute_name" model="ir.config_parameter">
        <field name="key">tr_pricelist_report.group_attribute_name</field>
        <field name="value">MARCA</field>
    </record>

    <record id="config_history_months_back" model="ir.config_parameter">
        <field name="key">tr_pricelist_report.history_months_back</field>
        <field name="value">6</field>
    </record>

    <record id="config_invalid_price_threshold" model="ir.config_parameter">
        <field name="key">tr_pricelist_report.invalid_price_threshold</field>
        <field name="value">99999.0</field>
    </record>

</odoo>
