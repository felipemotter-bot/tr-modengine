<odoo noupdate="1">

    <record id="email_template_pricelist" model="mail.template">
        <field name="name">Pricelist Report: Send to Customer</field>
        <field
      name="model_id"
      ref="tr_commercial_policy.model_partner_commercial_condition"
    />
        <field
      name="subject"
    >{{ 'Price List - ' + (object.partner_id.name or '') }}</field>
        <field name="partner_to">{{ object.partner_id.id or '' }}</field>
        <field name="body_html" type="html">
            <div>
                <p t-out="object.partner_id.name or ''" />
                <p>
                    Please find attached the up-to-date price list for the
                    period configured on your commercial condition.
                </p>
                <p>
                    Let us know if you have any question.
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="True" />
    </record>

</odoo>
