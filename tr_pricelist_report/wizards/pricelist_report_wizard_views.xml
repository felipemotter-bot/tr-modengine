<odoo>

    <record id="view_pricelist_report_wizard_form" model="ir.ui.view">
        <field name="name">tr.pricelist.report.wizard.form</field>
        <field name="model">tr.pricelist.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Price List">
                <sheet>
                    <group>
                        <group>
                            <field name="condition_id" readonly="1" />
                            <field name="layout" />
                            <field
                name="group_axis"
                attrs="{'invisible': [('layout', '!=', 'geral')]}"
              />
                            <field
                name="history_grouping"
                widget="radio"
                attrs="{'invisible': [('layout', '!=', 'historico')]}"
              />
                            <field name="discount_display" />
                            <field name="send_by_email" />
                        </group>
                        <group>
                            <field
                name="category_ids"
                widget="many2many_tags"
                options="{'no_create': True}"
              />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
            name="action_generate"
            string="Generate PDF"
            type="object"
            class="btn-primary"
          />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
