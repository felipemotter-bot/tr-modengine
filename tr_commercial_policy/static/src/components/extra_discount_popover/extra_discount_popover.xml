<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Popover content: form with discount + reason -->
    <t t-name="tr_commercial_policy.ExtraDiscountPopoverContent" owl="1">
        <div class="p-3" style="min-width: 280px;">
            <div class="mb-2">
                <label class="fw-bold small">Extra Discount (%)</label>
                <input
          type="text"
          inputmode="decimal"
          class="form-control form-control-sm"
          t-att-value="state.extraDiscountText"
          t-on-input="onDiscountInput"
          t-on-focus="onDiscountFocus"
          placeholder="0"
        />
            </div>
            <div class="mb-2">
                <label class="fw-bold small">Reason</label>
                <input
          type="text"
          class="form-control form-control-sm"
          t-att-value="state.reason"
          t-on-input="(ev) => this.state.reason = ev.target.value"
          placeholder="Optional"
        />
            </div>
            <div t-if="state.error" class="text-danger small mb-2">
                <i class="fa fa-exclamation-triangle" />
                <t t-esc="state.error" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" t-on-click="onApply">
                    Apply
                </button>
                <button class="btn btn-outline-secondary btn-sm" t-on-click="onClear">
                    Clear
                </button>
            </div>
        </div>
    </t>

    <!-- Field widget: button with value when set -->
    <t t-name="tr_commercial_policy.ExtraDiscountField" owl="1">
        <button
      t-if="isEditable"
      class="btn btn-link btn-sm p-0 text-nowrap"
      t-on-click="onButtonClick"
    >
            <i class="fa fa-plus-circle me-1" />
            <t t-if="hasExtraDiscount">
                <t t-esc="formatDiscount(extraDiscount)" />% Extra
            </t>
            <t t-else="">
                Extra
            </t>
        </button>
    </t>

</templates>
