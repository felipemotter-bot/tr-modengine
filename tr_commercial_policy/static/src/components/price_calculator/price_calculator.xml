<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Popover content: price calculator -->
    <t t-name="tr_commercial_policy.PriceCalculatorPopoverContent" owl="1">
        <div class="p-3" style="min-width: 300px;">
            <div class="mb-3">
                <label class="fw-bold small">Target Price</label>
                <input
          type="text"
          inputmode="decimal"
          class="form-control form-control-sm"
          t-att-value="state.desiredPrice"
          t-on-input="onPriceInput"
          t-on-focus="onPriceFocus"
          placeholder="0,00"
          autofocus="autofocus"
        />
            </div>

            <t t-if="preview">
                <div t-if="preview.error" class="text-danger small mb-2">
                    <i class="fa fa-exclamation-triangle" />
                    <t t-esc="preview.error" />
                </div>

                <t t-if="!preview.error">
                    <div class="small mb-1">
                        <span class="text-muted">Seller discount:</span>
                        <span class="fw-bold ms-1">
                            <t t-esc="formatDiscount(preview.sellerDiscount)" />%
                        </span>
                    </div>
                    <div t-if="preview.extraDiscount > 0" class="small mb-1">
                        <span class="text-warning">
                            <i class="fa fa-exclamation-triangle" />
                            Extra discount:
                        </span>
                        <span class="fw-bold ms-1">
                            <t t-esc="formatDiscount(preview.extraDiscount)" />%
                        </span>
                    </div>
                    <div class="small mb-2">
                        <span class="text-muted">Resulting price:</span>
                        <span class="fw-bold ms-1">
                            R$ <t t-esc="formatPrice(preview.resultingPrice)" />
                        </span>
                    </div>
                    <div
            t-if="preview.extraDiscount > 0"
            class="alert alert-warning small p-2 mb-2"
          >
                        <i class="fa fa-lock" />
                        Extra discount requires approval.
                    </div>
                    <div t-if="preview.extraDiscount > 0" class="mb-3">
                        <label class="fw-bold small">Reason</label>
                        <input
              type="text"
              class="form-control form-control-sm"
              t-att-value="state.reason"
              t-on-input="(ev) => this.state.reason = ev.target.value"
              placeholder="Optional"
            />
                    </div>
                    <button class="btn btn-primary btn-sm" t-on-click="onApply">
                        Apply
                    </button>
                </t>
            </t>
        </div>
    </t>

    <!-- Field widget: calculator button -->
    <t t-name="tr_commercial_policy.PriceCalculatorButton" owl="1">
        <button
      t-if="isVisible"
      class="btn btn-link btn-sm p-0 text-nowrap ms-1"
      t-on-click="onButtonClick"
      title="Calculate discount for a target price"
    >
            <i class="fa fa-calculator" />
        </button>
    </t>

</templates>
