<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_commercial_policy" model="ir.module.category">
        <field name="name">Commercial Policy</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="category_id" ref="module_category_commercial_policy" />
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]" />
        <field name="comment">
            Can approve extra discounts up to manager limit.
            Can manage commercial conditions.
        </field>
    </record>

    <record id="group_sales_director" model="res.groups">
        <field name="name">Sales Director</field>
        <field name="category_id" ref="module_category_commercial_policy" />
        <field name="implied_ids" eval="[(4, ref('group_sales_manager'))]" />
        <field name="comment">
            Can approve extra discounts beyond manager limit.
            Can manage sales profiles.
        </field>
    </record>

    <!-- Admin inherits Sales Director permissions -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sales_director'))]" />
    </record>
</odoo>
