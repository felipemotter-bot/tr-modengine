<odoo>

    <!--
        Sales-profile-specific stylesheet.

        Common rules (centered uppercase document title, blue-bordered section
        heading) live in ``tr_report_style.report_styles`` and are applied via
        the ``.tr-*`` classes the main template emits. This file carries only
        the profile-specific structures: side-by-side limit cards, the
        two-column band-grid, and the band sub-tables.
    -->
    <template id="report_sales_profile_styles">
        <style>
            /* ---------- Limits row (cash + fob side by side) --------
               wkhtmltopdf does not render CSS flex/grid reliably, so
               we use floats. Two columns at 48% with a 4% gutter. */
            .profile-limits-row { margin-top: 6pt; }
            .profile-limits-row::after {
                content: "";
                display: block;
                clear: both;
            }
            .profile-limits-col {
                float: left;
                width: 48%;
                box-sizing: border-box;
            }
            .profile-limits-col + .profile-limits-col {
                margin-left: 4%;
            }
            .profile-limit-label {
                font-size: 10pt;
                font-weight: 600;
                color: #002FA7;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                margin-bottom: 2pt;
            }
            .profile-limit-value {
                font-size: 14pt;
                font-weight: 600;
                color: #111;
                margin-bottom: 4pt;
            }
            .profile-limit-meta {
                font-size: 9.5pt;
                color: #555;
            }
            .profile-limit-meta ul {
                margin: 2pt 0 0 16pt;
                padding: 0;
            }
            .profile-limit-meta li { margin: 0; }

            /* ---------- Band tables ---------------------------------
               Cards flow in a two-column grid (float-based to survive
               wkhtmltopdf), wrapping naturally as more rules show up.
               Each card holds a subtitle + the band table at full
               width of the column. */
            .profile-bands-grid::after {
                content: "";
                display: block;
                clear: both;
            }
            .profile-band-block {
                float: left;
                width: 48%;
                margin-top: 10pt;
                box-sizing: border-box;
            }
            .profile-band-block:nth-child(odd) {
                clear: left;
                margin-right: 4%;
            }
            .profile-band-subtitle {
                font-size: 10pt;
                font-weight: 600;
                color: #333;
                margin: 0 0 3pt 0;
            }
            .profile-band-subtitle .profile-band-qualifier {
                font-weight: 400;
                color: #666;
            }
            .profile-band-table {
                width: 100%;
                margin: 0;
            }
            .profile-band-table,
            .profile-band-table thead,
            .profile-band-table tbody,
            .profile-band-table tr,
            .profile-band-table th,
            .profile-band-table td {
                border: 0 !important;
                box-shadow: none !important;
            }
            .profile-band-table {
                border-collapse: separate !important;
                border-spacing: 0 !important;
            }
            .profile-band-table thead th {
                font-size: 8.5pt;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                color: #666;
                border-bottom: 1px solid #cfcfcf !important;
                padding: 6pt 8pt;
                text-align: right;
                white-space: nowrap;
            }
            .profile-band-table tbody td {
                padding: 5pt 8pt;
                border-bottom: 1px solid #eee !important;
                text-align: right;
                font-size: 10pt;
            }
            .profile-band-table tbody tr:nth-child(even) {
                background: #fafafa;
            }
        </style>
    </template>

</odoo>
