<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
    id="report_saleorder_document_inherit"
    inherit_id="sale.report_saleorder_document"
  >
        <!--
            When discount_display == 'show_discounts':
            Insert Reference Price and Seller Discount columns after Unit Price.
        -->

        <!-- Add reference_price column header after Unit Price header -->
        <xpath expr="//th[@name='th_priceunit']" position="after">
            <th
        name="th_reference_price"
        class="text-end"
        t-if="doc.discount_display == 'show_discounts'"
      >
                <span>Ref. Price</span>
            </th>
            <th
        name="th_seller_discount"
        class="text-end"
        t-if="doc.discount_display == 'show_discounts'"
      >
                <span>Seller Disc.%</span>
            </th>
        </xpath>

        <!-- Add reference_price and seller_discount data cells after price_unit -->
        <xpath expr="//td[@name='td_priceunit']" position="after">
            <td
        name="td_reference_price"
        class="text-end"
        t-if="doc.discount_display == 'show_discounts'"
      >
                <span t-if="line.seller_discount >= 0" t-field="line.reference_price" />
                <span t-else="" t-field="line.price_unit" />
            </td>
            <td
        name="td_seller_discount"
        class="text-end"
        t-if="doc.discount_display == 'show_discounts'"
      >
                <span t-if="line.seller_discount >= 0" t-field="line.seller_discount" />
                <span t-else="">0,00</span>
            </td>
        </xpath>
    </template>
</odoo>
