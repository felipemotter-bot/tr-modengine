<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_sales_profile_document">
        <t t-call="trento_report_utils.external_layout_boxed_compact">
            <div class="page">

                    <t t-call="tr_commercial_policy.report_sales_profile_styles" />

                    <!-- Header: title + meta (perfil / empresa / emissão) -->
                    <div class="profile-header">
                        <h2 class="profile-header-title">PERFIL COMERCIAL</h2>
                        <div class="profile-header-meta">
                            <div>
                                <strong>Perfil:</strong>
                                <span t-field="doc.name" />
                            </div>
                            <div>
                                <strong>Empresa:</strong>
                                <span t-field="doc.company_id.name" />
                            </div>
                            <div>
                                <strong>Emissão:</strong>
                                <span
                t-esc="context_timestamp(datetime.datetime.now())"
                t-options="{'widget': 'date'}"
              />
                            </div>
                        </div>
                    </div>

                    <!-- Limits: cash + fob side by side -->
                    <div class="profile-section">
                        <h3 class="profile-section-title">Limites de Desconto</h3>
                        <div class="profile-limits-row">
                            <div class="profile-limits-col">
                                <div class="profile-limit-label">Desconto à Vista</div>
                                <div class="profile-limit-value">
                                    <span t-esc="'%.2f' % doc.cash_discount_max" />%
                                </div>
                                <div
                t-if="doc.cash_term_avg_days_max or doc.payment_mode_ids"
                class="profile-limit-meta"
              >
                                    <strong>Condições para conceder:</strong>
                                    <ul>
                                        <li t-if="doc.cash_term_avg_days_max">
                                            Prazo médio máximo:
                                            <span
                      t-esc="doc.cash_term_avg_days_max"
                    /> dias
                                        </li>
                                        <li t-if="doc.payment_mode_ids">
                                            Modos de pagamento permitidos:
                                            <span
                      t-esc="', '.join(doc.payment_mode_ids.mapped('name'))"
                    />
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="profile-limits-col">
                                <div class="profile-limit-label">Desconto FOB</div>
                                <div class="profile-limit-value">
                                    <span t-esc="'%.2f' % doc.fob_discount_max" />%
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bands by scope -->
                    <div class="profile-section">
                        <h3
            class="profile-section-title"
          >Faixas de Desconto por Escopo</h3>
                        <div class="profile-bands-grid">
                            <t t-foreach="doc.rule_ids" t-as="rule">
                            <!-- Scope label: textual description of the rule's applied_on. -->
                            <t
                t-set="scope_label"
                t-value="rule.applied_on == 'general' and 'Geral' or (rule.applied_on == 'category' and ('Categoria: ' + rule.categ_id.display_name)) or (rule.applied_on == 'product_template' and ('Linha de Produto: ' + rule.product_tmpl_id.display_name)) or (rule.applied_on == 'product' and ('Variante: ' + rule.product_id.display_name)) or ''"
              />
                            <!-- Qty qualifier: differentiates volume bands within the same scope. -->
                            <t
                t-set="qty_label"
                t-value="rule.qty_min and ('A partir de %s %s' % (('%g' % rule.qty_min), rule.qty_uom_id.name or '')) or 'Sem quantidade mínima'"
              />
                            <div class="profile-band-block">
                                <div class="profile-band-subtitle">
                                    <span t-esc="scope_label" />
                                    <span class="profile-band-qualifier"> ·
                                        <t t-esc="qty_label" />
                                    </span>
                                </div>
                                <t t-if="doc.profile_type == 'agent'">
                                    <table class="profile-band-table">
                                        <thead>
                                            <tr>
                                                <th>Desconto até (%)</th>
                                                <th>Comissão (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr
                        t-foreach="rule.commission_band_ids.sorted('discount_up_to')"
                        t-as="band"
                      >
                                                <td>
                                                    <span
                            t-esc="'%.2f' % band.discount_up_to"
                          />
                                                </td>
                                                <td>
                                                    <span
                            t-esc="'%.2f' % band.commission_rate"
                          />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-if="doc.profile_type == 'internal'">
                                    <table class="profile-band-table">
                                        <thead>
                                            <tr>
                                                <th>Valor mínimo do pedido</th>
                                                <th>Desconto máximo (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr
                        t-foreach="rule.order_value_band_ids.sorted('order_min_amount')"
                        t-as="band"
                      >
                                                <td>
                                                    <span
                            t-field="band.order_min_amount"
                            t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'
                          />
                                                </td>
                                                <td>
                                                    <span
                            t-esc="'%.2f' % band.seller_discount_max"
                          />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </t>
                        </div>
                    </div>

            </div>
        </t>
    </template>

    <template id="report_sales_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="tr_commercial_policy.report_sales_profile_document" />
            </t>
        </t>
    </template>
</odoo>
