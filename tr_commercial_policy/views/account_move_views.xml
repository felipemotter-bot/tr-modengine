<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Account Move Form: commercial policy for sales invoices.
         Inherits from trento_invoice_usability's view to add policy
         fields to the reorganized layout. -->
    <record id="account_move_form_commercial_policy" model="ir.ui.view">
        <field name="name">account.move.form.commercial.policy</field>
        <field name="model">account.move</field>
        <field
      name="inherit_id"
      ref="trento_invoice_usability.account_move_form_usability"
    />
        <field name="priority">140</field>
        <field name="arch" type="xml">
            <!-- Hidden helper fields -->
            <field name="totals_show_gross" position="after">
                <field name="has_sale_origin" invisible="1" />
                <field name="unmanaged_commission_warning" invisible="1" />
                <field name="discount_approval_level" invisible="1" />
                <field name="validation_status" invisible="1" />
                <field name="invoice_discount_pct" invisible="1" />
                <field name="adjustment_factor_display" invisible="1" />
                <field name="invoice_divergence_warning" invisible="1" />
            </field>

            <!-- Warning banner for unmanaged commissions -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div
          class="alert alert-warning mb-1"
          role="alert"
          attrs="{'invisible': [
                        '|',
                        ('unmanaged_commission_warning', '=', False),
                        ('move_type', 'not in', ['out_invoice'])
                    ]}"
        >
                    <field name="unmanaged_commission_warning" />
                </div>
                <!-- Discount approval banner -->
                <div
          class="alert alert-secondary mb-1"
          role="alert"
          attrs="{'invisible': [
                        '|', '|',
                        ('discount_approval_level', '=', 'none'),
                        ('discount_approval_level', '=', False),
                        ('validation_status', '=', 'validated')
                    ]}"
        >
                    <strong>Discount approval required:</strong>
                    <field name="discount_approval_snapshot" widget="text" />
                </div>
                <!-- Sale-origin invoice divergence banner -->
                <div
          class="alert alert-warning mb-1"
          role="alert"
          attrs="{'invisible': [('invoice_divergence_warning', '=', False)]}"
        >
                    <field name="invoice_divergence_warning" widget="text" />
                </div>
            </xpath>

            <!-- Commercial policy fields in header -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field
          name="tr_cash_discount"
          string="Cash Discount (%)"
          attrs="{
                        'readonly': [('state', '!=', 'draft')],
                        'invisible': [
                            ('move_type', 'not in',
                             ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'])
                        ]
                    }"
        />
                <field
          name="tr_fob_discount"
          string="FOB Discount (%)"
          attrs="{
                        'readonly': [('state', '!=', 'draft')],
                        'invisible': [
                            ('move_type', 'not in',
                             ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'])
                        ]
                    }"
        />
                <field
          name="invoice_discount_pct"
          string="Invoice Discount (%)"
          readonly="1"
          attrs="{
                        'invisible': [
                            ('move_type', 'not in',
                             ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'])
                        ]
                    }"
        />
            </xpath>

            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field
          name="effective_pricelist_id"
          string="Pricelist"
          readonly="1"
          options="{'no_open': True}"
          attrs="{
                        'invisible': [
                            ('move_type', 'not in', ['out_invoice', 'out_refund'])
                        ]
                    }"
        />
                <label
          for="tr_contractual_return"
          string="Contractual Return"
          attrs="{
                        'invisible': [
                            ('move_type', 'not in', ['out_invoice', 'out_refund'])
                        ]
                    }"
        />
                <div
          attrs="{
                        'invisible': [
                            ('move_type', 'not in', ['out_invoice', 'out_refund'])
                        ]
                    }"
        >
                    <field
            name="tr_contractual_return"
            class="oe_inline"
            readonly="1"
          />
                    <span> %</span>
                    <span
            class="text-muted ms-1"
            attrs="{'invisible': [('adjustment_factor_display', '=', '')]}"
          >
                        <field name="adjustment_factor_display" class="oe_inline" />
                    </span>
                </div>
                <field
          name="sales_profile_id"
          string="Sales Profile"
          readonly="1"
          options="{'no_open': True}"
          attrs="{
                        'invisible': [
                            ('move_type', 'not in', ['out_invoice', 'out_refund'])
                        ]
                    }"
        />
                <field
          name="commercial_condition_id"
          string="Commercial Condition"
          readonly="1"
          options="{'no_open': True}"
          attrs="{
                        'invisible': [
                            ('move_type', 'not in', ['out_invoice', 'out_refund'])
                        ]
                    }"
        />
            </xpath>

            <!-- Add policy fields to invoice line tree -->
            <xpath
        expr="//field[@name='invoice_line_ids']/tree//field[@name='price_unit']"
        position="before"
      >
                <field name="locked_condition_line_id" invisible="True" />
                <field name="tr_locked_readonly_for_user" invisible="True" />
                <field
          name="seller_discount"
          string="Seller Disc. (%)"
          optional="hide"
          attrs="{'column_invisible': [('parent.move_type', 'not in', ['out_invoice', 'out_refund'])], 'readonly': [('tr_locked_readonly_for_user', '=', True)]}"
        />
                <field
          name="extra_discount"
          string="Extra Disc. (%)"
          optional="hide"
          attrs="{'column_invisible': [('parent.move_type', 'not in', ['out_invoice', 'out_refund'])], 'readonly': [('tr_locked_readonly_for_user', '=', True)]}"
        />
                <field
          name="reference_price"
          string="Ref. Price"
          optional="hide"
          readonly="1"
          attrs="{'column_invisible': [('parent.move_type', 'not in', ['out_invoice', 'out_refund'])]}"
        />
                <field
          name="commission_rate"
          string="Commission (%)"
          optional="hide"
          readonly="1"
          attrs="{'column_invisible': [('parent.move_type', 'not in', ['out_invoice', 'out_refund'])]}"
        />
            </xpath>

            <!-- base_price before seller_discount -->
            <xpath
        expr="//field[@name='invoice_line_ids']/tree//field[@name='seller_discount']"
        position="before"
      >
                <field
          name="base_price"
          string="Base Price"
          optional="hide"
          readonly="1"
          attrs="{'column_invisible': [('parent.move_type', 'not in', ['out_invoice', 'out_refund'])]}"
        />
            </xpath>

            <!-- Inject policy fields into the 2-column layout anchors
                 provided by trento_invoice_usability. -->
            <xpath
        expr="//field[@name='invoice_line_ids']/form/sheet/group/group[@name='invoice_line_left']"
        position="inside"
      >
                <!-- Hidden helper for attrs access -->
                <field name="contractual_return" invisible="1" />
                <field
          name="base_price"
          readonly="1"
          attrs="{'invisible': [
                        '|', '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund']),
                        ('contractual_return', '=', 0)
                    ]}"
        />
                <label
          for="contractual_return"
          string="Contractual Return"
          attrs="{'invisible': [
                        '|', '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund']),
                        ('contractual_return', '=', 0)
                    ]}"
        />
                <div
          class="o_row"
          attrs="{'invisible': [
                        '|', '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund']),
                        ('contractual_return', '=', 0)
                    ]}"
        >
                    <field name="contractual_return" class="oe_inline" readonly="1" /> %
                    <span class="text-muted">
                        <field name="adjustment_factor_display" class="oe_inline" />
                    </span>
                </div>
                <label
          for="price_unit"
          string="Unit Price"
          attrs="{'invisible': [
                        '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund'])
                    ]}"
        />
                <div
          class="o_row"
          attrs="{'invisible': [
                        '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund'])
                    ]}"
        >
                    <span class="text-muted small">
                        <field name="reference_price" class="oe_inline" readonly="1" />
                        →
                    </span>
                    <span class="tr_price_actions">
                        <field name="allow_manual_price_edit" invisible="1" />
                        <field
              name="price_unit"
              class="oe_inline fw-bold"
              digits="[16,2]"
              attrs="{'readonly': [
                            '&amp;',
                            ('parent.move_type', '=', 'out_invoice'),
                            '|',
                            ('sale_line_ids', '!=', []),
                            ('allow_manual_price_edit', '=', False)
                        ]}"
            />
                        <field
              name="reference_price"
              widget="price_calculator_button"
              attrs="{'invisible': ['|', ('parent.state', '!=', 'draft'), ('tr_locked_readonly_for_user', '=', True)]}"
            />
                    </span>
                </div>

                <!-- Seller discount + extra discount popover button -->
                <field name="extra_discount_reason" invisible="1" />
                <field name="tr_locked_readonly_for_user" invisible="1" />
                <label
          for="seller_discount"
          string="Seller Discount"
          attrs="{'invisible': [
                        '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund'])
                    ]}"
        />
                <div
          name="seller_discount"
          class="o_row"
          attrs="{'invisible': [
                        '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund'])
                    ]}"
        >
                    <field name="seller_discount_max" invisible="1" />
                    <field name="seller_markup_max" invisible="1" />
                    <field
            name="seller_discount"
            class="oe_inline"
            style="max-width: 60px;"
            attrs="{'readonly': [('tr_locked_readonly_for_user', '=', True)]}"
          /> %
                    <span
            class="text-muted"
            attrs="{'invisible': [('seller_discount_max', '=', 0)]}"
          >
                        (máx: <field
              name="seller_discount_max"
              class="oe_inline"
              readonly="1"
            /> %)
                    </span>
                    <span class="tr_discount_actions">
                        <field
              name="extra_discount"
              widget="extra_discount_popover"
              attrs="{'invisible': ['|', '|', ('parent.state', '!=', 'draft'), ('seller_discount', '&lt;', 0), ('tr_locked_readonly_for_user', '=', True)]}"
            />
                    </span>
                </div>

                <!-- Total discount (visible only when extra_discount > 0 and no markup) -->
                <label
          for="total_seller_extra_discount"
          string="Total Discount"
          style="white-space: nowrap;"
          attrs="{'invisible': ['|', '|',
                        ('display_type', '!=', 'product'),
                        ('extra_discount', '=', 0),
                        ('seller_discount', '&lt;', 0)
                    ]}"
        />
                <div
          class="o_row"
          attrs="{'invisible': ['|', '|',
                        ('display_type', '!=', 'product'),
                        ('extra_discount', '=', 0),
                        ('seller_discount', '&lt;', 0)
                    ]}"
        >
                    <field
            name="total_seller_extra_discount"
            class="oe_inline"
            readonly="1"
            style="max-width: 60px;"
          /> %
                </div>
            </xpath>

            <xpath
        expr="//field[@name='invoice_line_ids']/form/sheet/group/group[@name='invoice_line_right']"
        position="inside"
      >
                <field
          name="commission_rate"
          string="Commission (%)"
          readonly="1"
          attrs="{'invisible': [
                        '|',
                        ('display_type', '!=', 'product'),
                        ('parent.move_type', 'not in', ['out_invoice', 'out_refund'])
                    ]}"
        />
            </xpath>

            <!-- Sale Order Lines goes to the "Others" tab (origin reference) -->
            <xpath
        expr="//field[@name='invoice_line_ids']/form/sheet/notebook/page[@name='others']"
        position="inside"
      >
                <group>
                    <field
            name="sale_line_ids"
            string="Sale Order Lines"
            readonly="1"
            widget="many2many_tags"
            options="{'no_create': True}"
            attrs="{'invisible': [
                            '|', '|',
                            ('display_type', '!=', 'product'),
                            ('parent.move_type', 'not in', ['out_invoice', 'out_refund']),
                            ('sale_line_ids', '=', [])
                        ]}"
          />
                </group>
            </xpath>
        </field>
    </record>

    <!-- Hide standard "Regenerate agents" when Resync is applicable -->
    <record id="account_move_form_resync_sale" model="ir.ui.view">
        <field name="name">account.move.form.resync.sale</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_commission.view_move_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//button[@name='recompute_lines_agents']"
        position="attributes"
      >
                <attribute name="attrs">{
                    'invisible': [
                        '&amp;',
                        ('move_type', '=', 'out_invoice'),
                        ('has_sale_origin', '=', True)
                    ]
                }</attribute>
            </xpath>
            <xpath expr="//button[@name='recompute_lines_agents']" position="after">
                <button
          name="action_resync_from_sale_order"
          type="object"
          string="Resync From Sale Order"
          attrs="{'invisible': [
                        '|', '|',
                        ('move_type', 'not in', ['out_invoice']),
                        ('state', '!=', 'draft'),
                        ('has_sale_origin', '=', False)
                    ]}"
        />
            </xpath>
        </field>
    </record>
</odoo>
