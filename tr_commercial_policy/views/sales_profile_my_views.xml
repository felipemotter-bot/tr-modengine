<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tr_sales_profile_my_action" model="ir.actions.act_window">
        <field name="name">My Commercial Profiles</field>
        <field name="res_model">tr.sales.profile</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commercial profile assigned to you
            </p>
            <p>
                A commercial profile defines the discount limits, payment
                conditions and commission bands you operate under.
                Profiles are assigned per company.
            </p>
        </field>
    </record>

    <record id="tr_sales_profile_my_action_server" model="ir.actions.server">
        <field name="name">My Commercial Profiles</field>
        <field name="model_id" ref="model_tr_sales_profile" />
        <field name="state">code</field>
        <field name="code">action = model.action_my_profiles()</field>
        <!--
            ir.actions.server.run() falls back to a write-access check on
            the target model when groups_id is empty (see
            odoo/addons/base/models/ir_actions.py). Since tr.sales.profile
            is read-only for base.group_user, that check would block any
            non-director user from opening the menu — including sales
            reps. Restricting the server action to base.group_user
            bypasses that fallback while still keeping the action
            invisible to portal/public users.
        -->
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]" />
    </record>

    <menuitem
    id="menu_my_sales_profiles"
    name="My Commercial Profiles"
    parent="sale.menu_sale_report"
    action="tr_sales_profile_my_action_server"
    sequence="100"
  />
</odoo>
