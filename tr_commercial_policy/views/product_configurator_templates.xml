<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Hide pricelist prices from the product configurator wizard.
         Prices shown here come from the pricelist and do not reflect
         the commercial policy (reference price + seller discount).
         The correct price_unit is applied to the order line after
         the product is confirmed. -->

    <template
    id="configure_hide_price"
    inherit_id="sale_product_configurator.configure"
  >
        <xpath expr="//h2" position="replace">
            <h2 />
        </xpath>
    </template>

    <template
    id="configure_optional_products_hide_price"
    inherit_id="sale_product_configurator.configure_optional_products"
  >
        <xpath expr="//th[hasclass('td-price')]" position="replace" />
        <xpath expr="//td[hasclass('td-price')]" position="replace" />
    </template>

    <template
    id="optional_product_items_hide_price"
    inherit_id="sale_product_configurator.optional_product_items"
  >
        <xpath expr="//td[hasclass('td-price')]" position="replace" />
    </template>
</odoo>
